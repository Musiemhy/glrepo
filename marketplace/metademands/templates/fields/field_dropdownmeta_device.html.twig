{#- Selection tiles of one device list.
 #
 #  Expected context:
 #    items : rows built by Dropdownmeta::buildDeviceRow(), each holding
 #            varname, values_name, value, selected, icon_html, name,
 #            tooltip_html and typename
 #
 #  The highlight of the picked tile is handled by public/scripts/dropdownmeta_device.js,
 #  which finds the tiles through the data-metademands-device marker.
-#}
{%- for item in items -%}
    <label id="{{ item.varname }}"
           class="btn md_buttonelt col-md-2 center {{ item.selected ? 'active md_buttonelt_color' : '' }}"
           data-metademands-device>
        <input type="radio" class="my_items" name="{{ item.values_name }}" value="{{ item.value }}"
               {{ item.selected ? 'checked' : '' }}>
        <div class="center">
            {{ item.icon_html|raw }}&nbsp;
            <h5 class="mt-0 mb-1 buttonelt-title">
                {{ item.name }}&nbsp;{% if item.tooltip_html is not empty %}&nbsp;{{ item.tooltip_html|raw }}{% endif %}
            </h5>
            <br>{{ item.typename }}
        </div>
    </label>
{%- endfor -%}
