function up_h($value): string
{
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function up_duration(?int $seconds): string
{
    if ($seconds === null || $seconds < 0) {
        return '-';
    }

    $days = intdiv($seconds, 86400);
    $seconds %= 86400;

    $hours = intdiv($seconds, 3600);
    $seconds %= 3600;

    $minutes = intdiv($seconds, 60);

    $parts = [];

    if ($days > 0) {
        $parts[] = $days . 'd';
    }

    if ($hours > 0) {
        $parts[] = $hours . 'h';
    }

    if ($minutes > 0 || empty($parts)) {
        $parts[] = $minutes . 'm';
    }

    return implode(' ', $parts);
}

function up_date_value(?string $date): ?int
{
    if (empty($date)) {
        return null;
    }

    $timestamp = strtotime($date);

    return $timestamp === false ? null : $timestamp;
}

function up_status_name(int $status): string
{
    $statuses = [
        1 => __('New'),
        2 => __('Processing (assigned)'),
        3 => __('Processing (planned)'),
        4 => __('Pending'),
        5 => __('Solved'),
        6 => __('Closed'),
    ];

    return $statuses[$status] ?? __('Unknown');
}

function up_priority_name(int $priority): string
{
    $priorities = [
        1 => __('Very low'),
        2 => __('Low'),
        3 => __('Medium'),
        4 => __('High'),
        5 => __('Very high'),
        6 => __('Major'),
    ];

    return $priorities[$priority] ?? __('Unknown');
}

/*
 * ---------------------------------------------------------
 * Filters
 * ---------------------------------------------------------
 */

$date_from = $_GET['date_from'] ?? date('Y-m-01');
$date_to   = $_GET['date_to'] ?? date('Y-m-d');

$technician_id = isset($_GET['technician_id'])
    ? (int)$_GET['technician_id']
    : 0;

$group_id = isset($_GET['group_id'])
    ? (int)$_GET['group_id']
    : 0;

$category_id = isset($_GET['category_id'])
    ? (int)$_GET['category_id']
    : 0;

$status_id = isset($_GET['status_id'])
    ? (int)$_GET['status_id']
    : 0;

$priority_id = isset($_GET['priority_id'])
    ? (int)$_GET['priority_id']
    : 0;

if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $date_from)) {
    $date_from = date('Y-m-01');
}

if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $date_to)) {
    $date_to = date('Y-m-d');
}

/*
 * End date is inclusive.
 */
$date_to_exclusive = date(
    'Y-m-d',
    strtotime($date_to . ' +1 day')
);

/*
 * ---------------------------------------------------------
 * Main assigned-ticket query
 * ---------------------------------------------------------
 *
 * type = 2 = technician assignment
 */

$criteria = [
    'SELECT' => [
        'glpi_tickets_users.users_id',
        'glpi_tickets_users.tickets_id',

        'glpi_tickets.id',
        'glpi_tickets.name',
        'glpi_tickets.type',
        'glpi_tickets.status',
        'glpi_tickets.priority',
        'glpi_tickets.itilcategories_id',
        'glpi_tickets.date',
        'glpi_tickets.solvedate',
        'glpi_tickets.closedate',
        'glpi_tickets.time_to_resolve',
    ],

    'FROM' => 'glpi_tickets_users',

    'INNER JOIN' => [
        'glpi_tickets' => [
            'ON' => [
                'glpi_tickets_users' => 'tickets_id',
                'glpi_tickets' => 'id',
            ],
        ],
    ],

    'WHERE' => [
        'glpi_tickets_users.type' => 2,
        'glpi_tickets.is_deleted' => 0,

        [
            'glpi_tickets.date' => [
                '>=',
                $date_from . ' 00:00:00',
            ],
        ],

        [
            'glpi_tickets.date' => [
                '<',
                $date_to_exclusive . ' 00:00:00',
            ],
        ],
    ],

    'ORDER' => [
        'glpi_tickets.date ASC',
    ],
];

/*
 * ---------------------------------------------------------
 * Technician filter
 * ---------------------------------------------------------
 */

if ($technician_id > 0) {
    $criteria['WHERE'][] = [
        'glpi_tickets_users.users_id' => $technician_id,
    ];
}

/*
 * ---------------------------------------------------------
 * Category filter
 * ---------------------------------------------------------
 */

if ($category_id > 0) {
    $criteria['WHERE'][] = [
        'glpi_tickets.itilcategories_id' => $category_id,
    ];
}

/*
 * ---------------------------------------------------------
 * Status filter
 * ---------------------------------------------------------
 */

if ($status_id > 0) {
    $criteria['WHERE'][] = [
        'glpi_tickets.status' => $status_id,
    ];
}

/*
 * ---------------------------------------------------------
 * Priority filter
 * ---------------------------------------------------------
 */

if ($priority_id > 0) {
    $criteria['WHERE'][] = [
        'glpi_tickets.priority' => $priority_id,
    ];
}

/*
 * ---------------------------------------------------------
 * Execute ticket query
 * ---------------------------------------------------------
 */

$ticket_iterator = $DB->request($criteria);

$ticket_data = [];
$ticket_technicians = [];

foreach ($ticket_iterator as $ticket) {

    $ticket_id = (int)$ticket['id'];
    $user_id   = (int)$ticket['users_id'];

    if (!isset($ticket_data[$ticket_id])) {
        $ticket_data[$ticket_id] = $ticket;
    }

    if (!isset($ticket_technicians[$ticket_id])) {
        $ticket_technicians[$ticket_id] = [];
    }

    $ticket_technicians[$ticket_id][$user_id] = true;
}

/*
 * ---------------------------------------------------------
 * Group filtering
 * ---------------------------------------------------------
 *
 * We apply group filtering after retrieving the assigned
 * technicians. This avoids overwriting the technician
 * filter when both filters are selected.
 */

if ($group_id > 0 && !empty($ticket_technicians)) {

    $group_users = [];

    $group_iterator = $DB->request([
        'SELECT' => [
            'users_id',
        ],

        'FROM' => 'glpi_groups_users',

        'WHERE' => [
            'groups_id' => $group_id,
        ],
    ]);

    foreach ($group_iterator as $group_user) {
        $group_users[(int)$group_user['users_id']] = true;
    }

    foreach ($ticket_technicians as $ticket_id => $users) {

        $belongs_to_group = false;

        foreach ($users as $uid => $unused) {
            if (isset($group_users[$uid])) {
                $belongs_to_group = true;
                break;
            }
        }

        if (!$belongs_to_group) {
            unset($ticket_data[$ticket_id]);
            unset($ticket_technicians[$ticket_id]);
        }
    }
}

/*
 * ---------------------------------------------------------
 * Technician information
 * ---------------------------------------------------------
 */

$technician_ids = [];

foreach ($ticket_technicians as $users) {
    foreach ($users as $uid => $unused) {
        $technician_ids[(int)$uid] = true;
    }
}

$technicians = [];

if (!empty($technician_ids)) {

    $user_iterator = $DB->request([
        'SELECT' => [
            'id',
            'name',
            'realname',
            'firstname',
        ],

        'FROM' => 'glpi_users',

        'WHERE' => [
            'id' => array_keys($technician_ids),
            'is_deleted' => 0,
        ],

        'ORDER' => [
            'name ASC',
        ],
    ]);

    foreach ($user_iterator as $user) {

        $uid = (int)$user['id'];

        /*
         * IMPORTANT:
         * GLPI username is stored in "name".
         *
         * Therefore users such as:
         * glpi
         * normal
         * tech
         *
         * are displayed correctly.
         */

        $display_name = trim(
            (string)$user['realname'] . ' ' .
            (string)$user['firstname']
        );

        if ($display_name === '') {
            $display_name = trim((string)$user['name']);
        }

        if ($display_name === '') {
            $display_name = 'Unknown technician';
        }

        $technicians[$uid] = $display_name;
    }
}

/*
 * ---------------------------------------------------------
 * Initialize technician statistics
 * ---------------------------------------------------------
 */

$stats = [];

foreach ($technicians as $uid => $name) {

    $stats[$uid] = [
        'name' => $name,

        'assigned' => 0,
        'written' => 0,
        'followups' => 0,

        'new' => 0,
        'processing' => 0,
        'pending' => 0,
        'solved' => 0,
        'closed' => 0,

        'sla_applicable' => 0,
        'sla_met' => 0,
        'sla_breaches' => 0,

        'tto_seconds' => [],
        'ttr_seconds' => [],
    ];
}

/*
 * ---------------------------------------------------------
 * Populate assignment statistics
 * ---------------------------------------------------------
 */

foreach ($ticket_technicians as $ticket_id => $users) {

    if (!isset($ticket_data[$ticket_id])) {
        continue;
    }

    $ticket = $ticket_data[$ticket_id];

    foreach ($users as $uid => $unused) {

        if (!isset($stats[$uid])) {
            $stats[$uid] = [
                'name' => 'Unknown technician',

                'assigned' => 0,
                'written' => 0,
                'followups' => 0,

                'new' => 0,
                'processing' => 0,
                'pending' => 0,
                'solved' => 0,
                'closed' => 0,

                'sla_applicable' => 0,
                'sla_met' => 0,
                'sla_breaches' => 0,

                'tto_seconds' => [],
                'ttr_seconds' => [],
            ];
        }

        $stats[$uid]['assigned']++;

        switch ((int)$ticket['status']) {

            case 1:
                $stats[$uid]['new']++;
                break;

            case 2:
            case 3:
                $stats[$uid]['processing']++;
                break;

            case 4:
                $stats[$uid]['pending']++;
                break;

            case 5:
                $stats[$uid]['solved']++;
                break;

            case 6:
                $stats[$uid]['closed']++;
                break;
        }

        /*
         * TTR
         */
        $opened = up_date_value($ticket['date']);

        $resolved = up_date_value(
            $ticket['solvedate']
            ?: $ticket['closedate']
        );

        if ($opened !== null && $resolved !== null && $resolved >= $opened) {
            $stats[$uid]['ttr_seconds'][] = $resolved - $opened;
        }

        /*
         * SLA
         */
        $sla_deadline = up_date_value($ticket['time_to_resolve']);

        if ($sla_deadline !== null && $sla_deadline > 0) {

            $stats[$uid]['sla_applicable']++;

            if ($resolved !== null) {

                if ($resolved <= $sla_deadline) {
                    $stats[$uid]['sla_met']++;
                } else {
                    $stats[$uid]['sla_breaches']++;
                }

            } elseif ($sla_deadline < time()) {

                $stats[$uid]['sla_breaches']++;
            }
        }
    }
}

/*
 * ---------------------------------------------------------
 * Follow-ups
 * ---------------------------------------------------------
 *
 * glpi_itilfollowups.users_id = author of follow-up
 */

$followup_by_ticket_user = [];
$first_response = [];

if (!empty($ticket_data)) {

    $ticket_ids = array_keys($ticket_data);

    $followup_iterator = $DB->request([
    'SELECT' => [
        'id',
        'itemtype',
        'items_id',
        'users_id',
        'date',
    ],

    'FROM' => 'glpi_itilfollowups',

    'WHERE' => [
        'itemtype' => 'Ticket',
        'items_id' => $ticket_ids,
        'is_private' => 0,
    ],

    'ORDER' => [
        'date ASC',
    ],
]);
    foreach ($followup_iterator as $followup) {

        $ticket_id = (int)$followup['items_id'];
        $user_id   = (int)$followup['users_id'];

        if (!isset($ticket_technicians[$ticket_id])) {
            continue;
        }

        /*
         * Count only follow-ups written by an assigned
         * technician on that ticket.
         */
        if (!isset($ticket_technicians[$ticket_id][$user_id])) {
            continue;
        }

        if (!isset($followup_by_ticket_user[$ticket_id])) {
            $followup_by_ticket_user[$ticket_id] = [];
        }

        if (!isset($followup_by_ticket_user[$ticket_id][$user_id])) {
            $followup_by_ticket_user[$ticket_id][$user_id] = 0;
        }

        $followup_by_ticket_user[$ticket_id][$user_id]++;

        /*
         * First technician response
         */
        if (!isset($first_response[$ticket_id])) {
            $first_response[$ticket_id] = [
                'users_id' => $user_id,
                'date' => $followup['date'],
            ];
        }
    }
}

/*
 * ---------------------------------------------------------
 * Add follow-up statistics
 * ---------------------------------------------------------
 */

foreach ($followup_by_ticket_user as $ticket_id => $users) {

    if (!isset($ticket_data[$ticket_id])) {
        continue;
    }

    foreach ($users as $uid => $count) {

        if (!isset($stats[$uid])) {
            continue;
        }

        $stats[$uid]['followups'] += $count;
        $stats[$uid]['written']++;
    }
}

/*
 * ---------------------------------------------------------
 * TTO
 * ---------------------------------------------------------
 */

foreach ($first_response as $ticket_id => $response) {

    $uid = (int)$response['users_id'];

    if (!isset($stats[$uid])) {
        continue;
    }

    if (!isset($ticket_data[$ticket_id])) {
        continue;
    }

    $opened = up_date_value($ticket_data[$ticket_id]['date']);
    $response_time = up_date_value($response['date']);

    if (
        $opened !== null
        && $response_time !== null
        && $response_time >= $opened
    ) {
        $stats[$uid]['tto_seconds'][] = $response_time - $opened;
    }
}

/*
 * ---------------------------------------------------------
 * Overall KPI
 * ---------------------------------------------------------
 */

$overall = [
    'assigned' => 0,
    'written' => 0,
    'followups' => 0,

    'new' => 0,
    'processing' => 0,
    'pending' => 0,
    'solved' => 0,
    'closed' => 0,

    'sla_applicable' => 0,
    'sla_met' => 0,
    'sla_breaches' => 0,

    'tto_seconds' => [],
    'ttr_seconds' => [],
];

foreach ($stats as $stat) {

    $overall['assigned'] += $stat['assigned'];
    $overall['written'] += $stat['written'];
    $overall['followups'] += $stat['followups'];

    $overall['new'] += $stat['new'];
    $overall['processing'] += $stat['processing'];
    $overall['pending'] += $stat['pending'];
    $overall['solved'] += $stat['solved'];
    $overall['closed'] += $stat['closed'];

    $overall['sla_applicable'] += $stat['sla_applicable'];
    $overall['sla_met'] += $stat['sla_met'];
    $overall['sla_breaches'] += $stat['sla_breaches'];

    $overall['tto_seconds'] = array_merge(
        $overall['tto_seconds'],
        $stat['tto_seconds']
    );

    $overall['ttr_seconds'] = array_merge(
        $overall['ttr_seconds'],
        $stat['ttr_seconds']
    );
}

$resolution_total =
    $overall['solved'] +
    $overall['closed'];

$resolution_rate = $overall['assigned'] > 0
    ? ($resolution_total / $overall['assigned']) * 100
    : 0;

$sla_compliance = $overall['sla_applicable'] > 0
    ? ($overall['sla_met'] / $overall['sla_applicable']) * 100
    : null;

$avg_tto = !empty($overall['tto_seconds'])
    ? (int)round(array_sum($overall['tto_seconds']) / count($overall['tto_seconds']))
    : null;

$avg_ttr = !empty($overall['ttr_seconds'])
    ? (int)round(array_sum($overall['ttr_seconds']) / count($overall['ttr_seconds']))
    : null;

/*
 * ---------------------------------------------------------
 * Filter lists
 * ---------------------------------------------------------
 */

$groups = [];

$group_iterator = $DB->request([
    'SELECT' => [
        'id',
        'name',
    ],

    'FROM' => 'glpi_groups',

    'ORDER' => [
        'name ASC',
    ],
]);

foreach ($group_iterator as $group) {
    $groups[(int)$group['id']] = $group['name'];
}

$all_users = [];

$user_iterator = $DB->request([
    'SELECT' => [
        'id',
        'name',
        'realname',
        'firstname',
    ],

    'FROM' => 'glpi_users',

    'WHERE' => [
        'is_deleted' => 0,
    ],

    'ORDER' => [
        'name ASC',
        'realname ASC',
        'firstname ASC',
    ],
]);

foreach ($user_iterator as $user) {

    $name = trim(
        (string)$user['realname'] . ' ' .
        (string)$user['firstname']
    );

    if ($name === '') {
        $name = trim((string)$user['name']);
    }

    if ($name === '') {
        $name = 'Unknown';
    }

    $all_users[(int)$user['id']] = $name;
}

$categories = [];

$category_iterator = $DB->request([
    'SELECT' => [
        'id',
        'completename',
    ],

    'FROM' => 'glpi_itilcategories',

    'ORDER' => [
        'completename ASC',
    ],
]);

foreach ($category_iterator as $category) {
    $categories[(int)$category['id']] = $category['completename'];
}

/*
 * ---------------------------------------------------------
 * Technician table helper
 * ---------------------------------------------------------
 */

function up_resolution_rate(array $stat): float
{
    return $stat['assigned'] > 0
        ? (
            (
                $stat['solved'] +
                $stat['closed']
            ) / $stat['assigned']
        ) * 100
        : 0;
}

function up_sla_rate(array $stat): ?float
{
    if ($stat['sla_applicable'] <= 0) {
        return null;
    }

    return (
        $stat['sla_met'] /
        $stat['sla_applicable']
    ) * 100;
}

function up_average(array $values): ?int
{
    if (empty($values)) {
        return null;
    }

    return (int)round(
        array_sum($values) / count($values)
    );
}

