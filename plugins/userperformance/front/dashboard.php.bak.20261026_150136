global $DB;

// ------------------------------------------------------------------
// 1. Read filters
// ------------------------------------------------------------------
$date_from   = $_GET['date_from']   ?? date('Y-m-01');
$date_to     = $_GET['date_to']     ?? date('Y-m-d');
$ticket_type = $_GET['ticket_type'] ?? '';
$tech_id     = $_GET['tech_id']     ?? '';
$group_id    = $_GET['group_id']    ?? '';
$cat_id      = $_GET['category']    ?? '';
$status      = $_GET['status']      ?? '';
$priority    = $_GET['priority']    ?? '';
$group_by    = $_GET['group_by']    ?? 'tech';
$sort_by     = $_GET['sort_by']     ?? 'total';
$sort_order  = ($_GET['sort_order'] ?? 'DESC') === 'ASC' ? 'ASC' : 'DESC';

// ------------------------------------------------------------------
// 2. Build SQL WHERE (always safe, no joins here)
// ------------------------------------------------------------------
$where   = ["glpi_tickets.is_deleted = 0"];
$where[] = "DATE(glpi_tickets.date) BETWEEN '{$date_from}' AND '{$date_to}'";

if ($ticket_type !== '') $where[] = "glpi_tickets.type = "             . (int)$ticket_type;
if ($status      !== '') $where[] = "glpi_tickets.status = "           . (int)$status;
if ($priority    !== '') $where[] = "glpi_tickets.priority = "         . (int)$priority;
if ($cat_id      !== '') $where[] = "glpi_tickets.itilcategories_id = ". (int)$cat_id;

if ($tech_id !== '') {
    $where[] = "EXISTS (SELECT 1 FROM glpi_tickets_users tu
                        WHERE tu.tickets_id = glpi_tickets.id
                          AND tu.users_id = " . (int)$tech_id . "
                          AND tu.type = 2)";
}
if ($group_id !== '') {
    $where[] = "EXISTS (SELECT 1 FROM glpi_groups_tickets gt
                        WHERE gt.tickets_id = glpi_tickets.id
                          AND gt.groups_id = " . (int)$group_id . "
                          AND gt.type = 2)";
}
$where_sql = implode(' AND ', $where);

// ------------------------------------------------------------------
// 3. Choose GROUP BY and title column
// ------------------------------------------------------------------
$select       = '';
$join         = '';
$group_by_sql = '';
$title_col    = '';

switch ($group_by) {
    case 'group':
        $join         = "LEFT JOIN glpi_groups_tickets gt ON (gt.tickets_id = glpi_tickets.id AND gt.type = 2)
                         LEFT JOIN glpi_groups g ON (g.id = gt.groups_id)";
        $select       = "IFNULL(g.name, 'No Group') AS group_name";
        $group_by_sql = "GROUP BY gt.groups_id, g.name";
        $title_col    = 'Support Group';
        break;

    case 'category':
        $join         = "LEFT JOIN glpi_itilcategories ic ON (ic.id = glpi_tickets.itilcategories_id)";
        $select       = "IFNULL(ic.name, 'No Category') AS group_name";
        $group_by_sql = "GROUP BY glpi_tickets.itilcategories_id, ic.name";
        $title_col    = 'Category';
        break;

    case 'priority':
        $select       = "CASE glpi_tickets.priority
                            WHEN 1 THEN 'Very Low' WHEN 2 THEN 'Low'
                            WHEN 3 THEN 'Medium'   WHEN 4 THEN 'High'
                            WHEN 5 THEN 'Very High' ELSE 'Unknown' END AS group_name";
        $group_by_sql = "GROUP BY glpi_tickets.priority";
        $title_col    = 'Priority';
        break;

    case 'status':
        $select       = "CASE glpi_tickets.status
                            WHEN 1 THEN 'New'      WHEN 2 THEN 'Assigned'
                            WHEN 3 THEN 'Planned'  WHEN 4 THEN 'Pending'
                            WHEN 5 THEN 'Solved'   WHEN 6 THEN 'Closed'
                            ELSE 'Other' END AS group_name";
        $group_by_sql = "GROUP BY glpi_tickets.status";
        $title_col    = 'Status';
        break;

    case 'type':
        $select       = "CASE glpi_tickets.type
                            WHEN 1 THEN 'Incident' WHEN 2 THEN 'Request'
                            ELSE 'Other' END AS group_name";
        $group_by_sql = "GROUP BY glpi_tickets.type";
        $title_col    = 'Ticket Type';
        break;

    case 'tech':
    default:
        $join         = "LEFT JOIN glpi_tickets_users tu ON (tu.tickets_id = glpi_tickets.id AND tu.type = 2)
                         LEFT JOIN glpi_users u ON (u.id = tu.users_id)";
        $select       = "IFNULL(u.name, 'Unassigned') AS group_name";
        $group_by_sql = "GROUP BY tu.users_id, u.name";
        $title_col    = 'Technician';
        break;
}

// ------------------------------------------------------------------
// 4. Main metrics query
// ------------------------------------------------------------------
$sql = "
    SELECT
        $select,
        COUNT(glpi_tickets.id) AS total,
        SUM(CASE WHEN glpi_tickets.status = 5 THEN 1 ELSE 0 END) AS solved,
        SUM(CASE WHEN glpi_tickets.status = 6 THEN 1 ELSE 0 END) AS closed,
        SUM(CASE WHEN glpi_tickets.status IN (5,6) THEN 1 ELSE 0 END) AS resolved,
        SUM(CASE
                WHEN ((glpi_tickets.solvedate IS NOT NULL AND glpi_tickets.solvedate <= glpi_tickets.time_to_resolve)
                  OR  (glpi_tickets.closedate IS NOT NULL AND glpi_tickets.closedate <= glpi_tickets.time_to_resolve))
                THEN 1 ELSE 0 END) AS sla_compliant,
        SUM(CASE
                WHEN (glpi_tickets.solvedate IS NOT NULL AND glpi_tickets.solvedate > glpi_tickets.time_to_resolve)
                  OR (glpi_tickets.closedate IS NOT NULL AND glpi_tickets.closedate > glpi_tickets.time_to_resolve)
                THEN 1 ELSE 0 END) AS late_done,
        SUM(CASE
                WHEN glpi_tickets.solvedate IS NULL
                 AND glpi_tickets.closedate IS NULL
                 AND NOW() > glpi_tickets.time_to_resolve
                THEN 1 ELSE 0 END) AS breached_open,
        AVG(IFNULL(TIMESTAMPDIFF(SECOND, glpi_tickets.date, glpi_tickets.takeintoaccountdate), 0)) AS avg_tto,
        AVG(IFNULL(TIMESTAMPDIFF(SECOND, glpi_tickets.date,
                                 IFNULL(glpi_tickets.solvedate, glpi_tickets.closedate)), 0)) AS avg_ttr,
        SUM((SELECT COUNT(*) FROM glpi_itilfollowups f
             WHERE f.itemtype = 'Ticket' AND f.items_id = glpi_tickets.id)) AS followups_count
    FROM glpi_tickets
    $join
    WHERE $where_sql
    $group_by_sql
";

$results = [];
try {
    $res = $DB->doQuery($sql);
    if ($res) {
        while ($row = $res->fetch_assoc()) {

            $total      = (int)$row['total'];
            $resolved   = (int)$row['resolved'];
            $sla_ok     = (int)$row['sla_compliant'];
            $followups  = (int)$row['followups_count'];
            $avg_tto    = (int)$row['avg_tto'];
            $avg_ttr    = (int)$row['avg_ttr'];

            $resolution_rate = $total > 0 ? ($resolved / $total) : 0;
            $sla_rate        = $total > 0 ? ($sla_ok  / $total) : 0;
            $pending         = $total - $resolved;
            $pending_score   = $total > 0 ? (1 - ($pending / $total)) : 0;
            $followup_score  = $total > 0 ? min(1, ($followups / $total)) : 0;
            $tto_eff         = $avg_tto > 0 ? max(0, 1 - ($avg_tto / 86400))  : 0;
            $ttr_eff         = $avg_ttr > 0 ? max(0, 1 - ($avg_ttr / 172800)) : 0;

            $perf = 0.35 * $sla_rate
                  + 0.30 * $resolution_rate
                  + 0.10 * $followup_score
                  + 0.10 * $pending_score
                  + 0.075 * $tto_eff
                  + 0.075 * $ttr_eff;

            $row['perf_index'] = round($perf * 100, 1);
            $results[] = $row;
        }
    }
} catch (\Throwable $e) {
    echo "<div class='alert alert-danger'><b>SQL Error:</b> "
        . htmlspecialchars($e->getMessage()) . "</div>";
}

// ------------------------------------------------------------------
// 5. Sort in PHP (Performance column isn't in SQL)
// ------------------------------------------------------------------
usort($results, function ($a, $b) use ($sort_by, $sort_order) {
    $map = [
        'total'   => 'total',
        'perf'    => 'perf_index',
        'solved'  => 'solved',
        'closed'  => 'closed',
        'sla_ok'  => 'sla_compliant',
        'sla_bad' => null, // computed below
    ];
    $key = $map[$sort_by] ?? 'total';

    if ($key === null) {
        $va = ($a['late_done'] + $a['breached_open']);
        $vb = ($b['late_done'] + $b['breached_open']);
    } else {
        $va = $a[$key];
        $vb = $b[$key];
    }

    if ($va == $vb) return 0;
    if ($sort_order === 'ASC') return ($va < $vb) ? -1 : 1;
    return ($va > $vb) ? -1 : 1;
});

function up_formatTime($seconds) {
    if (!$seconds) return '0s';
    $h = floor($seconds / 3600);
    $m = floor(($seconds % 3600) / 60);
    $s = $seconds % 60;
    return ($h > 0 ? "{$h}h " : '') . ($m > 0 ? "{$m}m " : '') . ($s > 0 ? "{$s}s" : '');
}
