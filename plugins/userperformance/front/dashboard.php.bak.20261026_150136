<script>
function upResetFilters() {
    window.location.href = "?date_from=<?= date('Y-m-01') ?>&date_to=<?= date('Y-m-d') ?>";
}

function upExportCSV() {
    const rows = document.querySelectorAll('#up-kpi-table tr');
    const csv  = [];
    rows.forEach(r => {
        const cols = r.querySelectorAll('td, th');
        const out  = [];
        cols.forEach(c => out.push('"' + c.innerText.replace(/(\r\n|\n|\r)/gm, ' ')
                                                     .replace(/\s+/gm, ' ') + '"'));
        csv.push(out.join(','));
    });
    const blob = new Blob([csv.join('\n')], {type: 'text/csv'});
    const a    = document.createElement('a');
    a.download = 'kpi_report.csv';
    a.href     = URL.createObjectURL(blob);
    document.body.appendChild(a); a.click(); a.remove();
}

function upExportXLSX() {
    const wb = XLSX.utils.table_to_book(document.getElementById('up-kpi-table'), {sheet: 'KPI'});
    XLSX.writeFile(wb, 'kpi_report.xlsx');
}

function upExportPDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF('l', 'mm', 'a4');
    doc.setFontSize(14);
    doc.text('KPI Report - <?= $title_col ?>', 14, 15);

    const headers = [];
    document.querySelectorAll('#up-kpi-table thead th').forEach(th => headers.push(th.innerText.trim()));

    const body = [];
    document.querySelectorAll('#up-kpi-table tbody tr').forEach(tr => {
        const row = [];
        tr.querySelectorAll('td').forEach(td => row.push(td.innerText.trim()));
        if (row.length) body.push(row);
    });

    doc.autoTable({
        head: [headers],
        body: body,
        startY: 20,
        theme: 'grid',
        styles: { fontSize: 9, cellPadding: 3 },
        headStyles: { fillColor: [32,107,196], textColor: 255, fontStyle: 'bold' },
        alternateRowStyles: { fillColor: [246,248,250] }
    });
    doc.save('kpi_report.pdf');
}
</script>

