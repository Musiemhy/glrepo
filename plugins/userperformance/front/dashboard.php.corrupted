                <option value="0">All</option>

                <?php foreach ($categories as $c): ?>

                    <option
                        value="<?= (int)$c['id'] ?>"
                        <?= $category_id == $c['id'] ? 'selected' : '' ?>
                    >
                        <?= htmlspecialchars($c['completename']) ?>
                    </option>

                <?php endforeach; ?>

            </select>

        </label>

        <label>
