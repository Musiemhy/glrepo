                            <?= (int)$r['pending'] ?>
                        </td>

                        <td>
                            <?= (int)$r['processing'] ?>
                        </td>

                        <td>
                            <?= (int)$r['new_tickets'] ?>
                        </td>

                        <td>
                            <?= (int)$r['written_tickets'] ?>
                        </td>

                        <td>
                            <?= htmlspecialchars(
                                (string)$r['resolution_rate']
                            ) ?>%
                        </td>

                        <td>
                            <?= (int)$r['sla_breaches'] ?>
                        </td>

                        <td>

                            <?=
                                $r['sla_compliance'] === null
                                ? 'N/A'
                                : htmlspecialchars(
                                    (string)$r['sla_compliance']
                                ) . '%'
                            ?>

                        </td>

                        <td>

                            <?=
                                $r['avg_tto_minutes'] === null
                                ? 'N/A'
                                : htmlspecialchars(
                                    (string)$r['avg_tto_minutes']
                                )
                            ?>

                        </td>

                        <td>

                            <?=
                                $r['avg_ttr_hours'] === null
                                ? 'N/A'
                                : htmlspecialchars(
                                    (string)$r['avg_ttr_hours']
                                )
                            ?>

                        </td>

                    </tr>

                <?php endforeach; ?>

                <?php if (!$rows): ?>

                    <tr>
                        <td
                            colspan="12"
                            class="up-empty"
                        >
                            No data found for the selected filters.
                        </td>
                    </tr>

                <?php endif; ?>

                </tbody>

            </table>

        </div>

    </div>

