                <option value="-1">All</option>

                <option value="1" <?= $status === 1 ? 'selected' : '' ?>>
                    New
                </option>

                <option value="2" <?= $status === 2 ? 'selected' : '' ?>>
                    Processing
                </option>

                <option value="3" <?= $status === 3 ? 'selected' : '' ?>>
                    Pending
                </option>

                <option value="4" <?= $status === 4 ? 'selected' : '' ?>>
                    Planning
                </option>

                <option value="5" <?= $status === 5 ? 'selected' : '' ?>>
                    Solved
                </option>

                <option value="6" <?= $status === 6 ? 'selected' : '' ?>>
                    Closed
                </option>

            </select>

        </label>

        <label>
            Priority

            <select name="priority">

                <option value="-1">All</option>

                <?php foreach (
                    [
                        1 => 'Very Low',
                        2 => 'Low',
                        3 => 'Medium',
                        4 => 'High',
                        5 => 'Very High',
                        6 => 'Major'
                    ] as $pid => $pname
                ): ?>

                    <option
                        value="<?= $pid ?>"
                        <?= $priority === $pid ? 'selected' : '' ?>
                    >
                        <?= htmlspecialchars($pname) ?>
                    </option>

                <?php endforeach; ?>

            </select>

        </label>

        <button
            class="up-btn up-primary"
            type="submit"
        >
            Apply
        </button>

    </form>

    <div class="up-cards">

        <?php

        $cards = [
            ['Assigned', $totals['assigned_tickets']],
            ['Resolved / Closed', $totals['resolved_closed']],
            ['Written / Follow-ups', $totals['written_tickets']],
            ['Resolution Rate', $overall_resolution . '%'],
            ['SLA Compliance', $overall_sla . '%'],
            ['SLA Breaches', $totals['sla_breaches']],
            ['Avg. TTO', $avg_tto . ' min'],
            ['Avg. TTR', $avg_ttr . ' hrs']
        ];

        foreach ($cards as $card):

        ?>

            <div class="up-card">

                <div class="up-card-label">
                    <?= htmlspecialchars($card[0]) ?>
                </div>

                <div class="up-card-value">
                    <?= htmlspecialchars((string)$card[1]) ?>
                </div>

            </div>

        <?php endforeach; ?>

    </div>

    <div class="up-panel">

        <h2>Technician Comparison</h2>

        <div class="up-table-wrap">

            <table class="up-table">

